# Python cache and bytecode
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Local runtime data. media.db is the live database; library.db is its former
# name, kept ignored so an old copy cannot be committed either.
media.db
media.backup*.db
library.db
library.backup*.db

# Imported watch history (F-0208.01) — a separate database from the library,
# same reasoning: personal runtime data, never committed.
history.db
history.backup*.db

# Transcode cache and scratch working files
tmp/

# Cached poster images (populated at runtime)
static/posters/*
!static/posters/.gitkeep

# Log files
*.log

# Editor settings are personal. .github/ is deliberately NOT ignored: it holds
# the coding standards in .github/instructions/, which have to travel with the
# repo to mean anything.
.vscode/

# Local secrets
.env

# Internal dev log (implementation notes, not for public repo)
Common/DevLog.md
